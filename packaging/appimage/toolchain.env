# The portable build's two inputs, pinned, in one file.
#
# **One file because two drifted.** These values used to be typed into
# `ci.yml` and `release.yml` separately, with a step that grepped one workflow
# for the other's strings to catch the mismatch. It caught one — and then the
# job holding the check was itself the thing that broke, so main went red on
# every push and the release quietly lost its cache. Both workflows and both
# scripts now source this; there is nothing left to disagree.
#
# Sourced by POSIX shell and read by the workflows through `$GITHUB_ENV`, so:
# plain `NAME=value`, no expansion, no quotes needed.

# AlmaLinux 8 as the manylinux project maintains it. Pinned by digest, not by
# tag: the floor this image sets is the compatibility promise in the changelog.
MANYLINUX_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:f854c50adf7b7a325bc4794316f3758d387a41d61f9e2ebca0f26c7dc8f761d4

QT_VERSION=6.11.1
QT_PREFIX=packaging/appimage/toolchain/qt-6.11.1

# Qt compiled on that image, published as a release asset. **Not an Actions
# cache**, which is where this lived until it cost four releases forty minutes
# each: a cache belongs to the ref that wrote it, so a tag build could never
# read its own last one, and the 10 GB repository limit evicted the 19 MiB
# entry behind caches twenty times its size. A release asset is neither scoped
# nor evicted, and the download is seconds.
#
# `publish-qt.sh` builds this and prints what to paste back here. Change the
# tag when the contents change: the SHA-256 is what is trusted, and the tag is
# how a bad one is left behind rather than overwritten.
QT_TOOLCHAIN_TAG=qt-6.11.1-manylinux_2_28-1
QT_TOOLCHAIN_FILE=qt-6.11.1-manylinux_2_28-x86_64.tar.xz
QT_TOOLCHAIN_SHA256=b781b7c11bdaa13d9aa6667e0e709b7b91586f67657d7f17102b5a114d7a3266
